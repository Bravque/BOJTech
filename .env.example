# ---------------------------------------------------------------------------
# Database (MySQL — Hostinger Business "Databases → Management")
# On Hostinger the DB runs on localhost. Format:
#   mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/bojtech"

# ---------------------------------------------------------------------------
# Admin authentication (NextAuth / Auth.js)
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
# NEXTAUTH_URL: the site's public URL (e.g. https://bojtechnologies.com)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Contact form email delivery (SMTP via Nodemailer)
# Use a mailbox on your own domain — on Hostinger, create it under
# hPanel → Emails, then use those credentials here.
#   SMTP_HOST: smtp.hostinger.com
#   SMTP_PORT: 465 (implicit TLS) or 587 (STARTTLS)
#   SMTP_USER: the full mailbox address, e.g. info@bojtechnologies.com
#   SMTP_PASSWORD: that mailbox's password
# Without these set, enquiries are validated and logged server-side (never
# silently lost) but no email is sent.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# From header — should match SMTP_USER's mailbox. A display name is fine,
# e.g. "BOJ Technologies <info@bojtechnologies.com>"
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Defaults to the info@ address in data/site.ts if unset.
CONTACT_TO_EMAIL=
