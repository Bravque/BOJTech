# ---------------------------------------------------------------------------
# Database (MySQL — Hostinger Business "Databases → Management")
# On Hostinger the DB runs on localhost. Format:
#   mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/bojtech"

# ---------------------------------------------------------------------------
# Admin authentication (NextAuth / Auth.js)
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
# NEXTAUTH_URL: the site's public URL (e.g. https://bojtechnologies.com)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Contact form email delivery (Resend — https://resend.com)
# 1. Create an API key.
# 2. Verify your sending domain (e.g. bojtechnologies.co.ke).
# 3. Copy this file to .env.local and fill in the values below.
# Without these set, enquiries are validated and logged server-side (never
# silently lost) but no email is sent.

RESEND_API_KEY=

# Verified sender address, e.g. "BOJ Technologies <no-reply@bojtechnologies.co.ke>"
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Defaults to the info@ address in data/site.ts if unset.
CONTACT_TO_EMAIL=
